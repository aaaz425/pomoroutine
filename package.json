{
  "name": "pomoroutine",
  "private": true,
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "dev": "turbo run dev --filter=web",
    "build": "turbo run build --filter=web",
    "lint": "turbo run lint",
    "format": "prettier --write .",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e --filter=web",
    "prepare": "lefthook install",
    "perf:seed": "node perf/seed/seed-sessions.mjs",
    "perf:k6": "sh perf/k6/run.sh"
  },
  "devDependencies": {
    "lefthook": "^2.1.9",
    "prettier": "^3.8.4",
    "turbo": "^2.10.8"
  }
}
